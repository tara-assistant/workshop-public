{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projects.metaengineershub.com/trip-planner/schema/trip.schema.json",
  "title": "Trip Planner trip file, schema 1",
  "type": "object",
  "required": ["schema", "id", "title", "phases"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "destination": { "type": "string", "maxLength": 160 },
    "startDate": { "type": "string", "format": "date" },
    "endDate": { "type": "string", "format": "date" },
    "summary": { "type": "string", "maxLength": 1200 },
    "note": { "type": "string", "maxLength": 400 },
    "center": { "$ref": "#/$defs/lngLat" },
    "zoom": { "type": "number", "minimum": 1, "maximum": 18 },
    "coverImage": { "$ref": "#/$defs/httpsUrl" },
    "theme": {
      "type": "object",
      "properties": {
        "hero": { "$ref": "#/$defs/color" },
        "phases": { "type": "array", "items": { "$ref": "#/$defs/color" }, "maxItems": 12 }
      }
    },
    "phases": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/phase" } }
  },
  "$defs": {
    "lngLat": { "type": "array", "prefixItems": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -85, "maximum": 85 }], "minItems": 2, "maxItems": 2 },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "httpsUrl": { "type": "string", "pattern": "^https?://", "maxLength": 2000 },
    "phase": {
      "type": "object",
      "required": ["id", "title", "days"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "subtitle": { "type": "string", "maxLength": 240 },
        "colorKey": { "type": "integer", "minimum": 1, "maximum": 12 },
        "days": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/day" } }
      }
    },
    "day": {
      "type": "object",
      "required": ["dayNumber", "title", "stops"],
      "properties": {
        "dayNumber": { "type": "integer", "minimum": 1 },
        "date": { "type": "string", "format": "date" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "photoUrl": { "$ref": "#/$defs/httpsUrl" },
        "photoCredit": { "type": "string", "maxLength": 200 },
        "photoSourceUrl": { "$ref": "#/$defs/httpsUrl" },
        "photoLicenseUrl": { "$ref": "#/$defs/httpsUrl" },
        "mode": { "enum": ["walking", "cycling", "driving"] },
        "stops": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/stop" } },
        "tips": { "type": "array", "items": { "type": "string", "maxLength": 600 } },
        "food": { "type": "string", "maxLength": 600 },
        "bookings": { "type": "array", "items": { "$ref": "#/$defs/booking" } },
        "packing": { "type": "array", "items": { "type": "string", "maxLength": 160 } },
        "weather": { "$ref": "#/$defs/weather" }
      }
    },
    "stop": {
      "type": "object",
      "required": ["id", "name", "lat", "lon"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "enum": ["sight", "gem", "hike", "dining", "cafe", "swim", "boat", "lodging", "transport"] },
        "time": { "type": "string", "maxLength": 40 },
        "dwell": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "desc": { "type": "string", "maxLength": 1200 },
        "lat": { "type": "number", "minimum": -85, "maximum": 85 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "tags": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "imageUrl": { "$ref": "#/$defs/httpsUrl" },
        "imageCredit": { "type": "string", "maxLength": 200 },
        "track": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 3, "prefixItems": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }], "items": { "type": "number" } }, "maxItems": 20000 },
        "source": { "type": "string", "maxLength": 400 },
        "verified": { "type": "string", "format": "date" },
        "visited": { "type": "boolean" }
      }
    },
    "link": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "kind": { "enum": ["map", "book", "hike", "web", "social"] },
        "label": { "type": "string", "maxLength": 80 },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "booking": {
      "type": "object",
      "required": ["label"],
      "properties": { "label": { "type": "string", "maxLength": 200 }, "url": { "$ref": "#/$defs/httpsUrl" } }
    },
    "weather": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["forecast", "typical"] },
        "fetchedAt": { "type": "string" },
        "tMax": { "type": "number" },
        "tMin": { "type": "number" },
        "rainChance": { "type": "number" },
        "windMax": { "type": "number" },
        "sunrise": { "type": "string" },
        "sunset": { "type": "string" }
      }
    }
  }
}
